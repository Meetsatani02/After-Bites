    "faq_FdDkeG": {
      "type": "faq",
      "blocks": {
        "faq_item_ihN9Cr": {
          "type": "faq_item",
          "settings": {
            "question": "What's inside this tal mukhwas?",
            "answer": "Slow roasted white sesame seeds (tal), candied fennel, dhaniya dal, dry coconut flakes, green cardamom, lemon and rock salt. There is no tobacco, no supari and no artificial colours or flavours."
          }
        },
        "faq_item_AHUhew": {
          "type": "faq_item",
          "settings": {
            "question": "How do I enjoy After Bites tal mukhwas?",
            "answer": "It's ready to eat straight from the jar, no preparation needed. Enjoy a teaspoon after meals to freshen your breath, or anytime you want a light, nutty and crunchy treat."
          }
        },
        "faq_item_TalDiff": {
          "type": "faq_item",
          "settings": {
            "question": "How is tal mukhwas different from paan mukhwas?",
            "answer": "Tal mukhwas is built around roasted sesame, so it tastes nutty, crisp and only lightly sweet. Our paan mukhwas is built around betel leaf and gulkand, so it tastes sweeter and more aromatic. Many families keep both on the table and switch between them."
          }
        },
        "faq_item_qT3TUi": {
          "type": "faq_item",
          "settings": {
            "question": "Is it suitable for kids and the whole family?",
            "answer": "Yes. It is free from tobacco and supari and made with natural ingredients, and sesame is naturally rich in calcium and iron. Please note it contains sesame and coconut, so avoid it if anyone in your family has a sesame or nut allergy."
          }
        },
        "faq_item_dW8Kns": {
          "type": "faq_item",
          "settings": {
            "question": "How fresh will my order arrive?",
            "answer": "Every jar is sealed to lock in flavour and freshness and arrives ready to enjoy. Once opened, store it in an airtight container in a cool, dry place and it stays fresh for up to 6 months."
          }
        }
      },
